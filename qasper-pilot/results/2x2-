dding_tokens": 26}, {"chunk_id": 65, "start_char": 12657, "end_char": 12849, "text": "Experiments show that an ensemble of our models reaches competitive accuracy on the WikiTableQuestions dataset, thus indicating its capability to answer complex, multi-compositional questions.", "embedding_tokens": 35}, {"chunk_id": 66, "start_char": 12850, "end_char": 12911, "text": "Our code is available at https://github.com/dalab/neural_qa .", "embedding_tokens": 23}, {"chunk_id": 67, "start_char": 12913, "end_char": 13095, "text": "This research was supported by the Swiss National Science Foundation (SNSF) grant number 407540_167176 under the project \"Conversational Agent for Interactive Access to Information\".", "embedding_tokens": 38}], "ranked_chunk_ids": [25, 34, 9, 27, 14, 4, 17, 6, 35, 8, 30, 57, 37, 49, 56, 19, 10, 20, 62, 12, 5, 1, 58, 40, 44, 66, 61, 63, 31, 0, 64, 41, 28, 26, 45, 2, 32, 65, 60, 51, 13, 54, 38, 23, 36, 18, 22, 67, 21, 24, 15, 43, 33, 59, 29, 3, 42, 48, 16, 53, 46, 39, 55, 11, 47, 50, 52, 7], "sorted_scores": [0.6760461330413818, 0.6736551523208618, 0.6515519618988037, 0.6428979635238647, 0.6313563585281372, 0.6258559226989746, 0.6043671369552612, 0.5989305973052979, 0.5856947898864746, 0.5844007730484009, 0.5838243365287781, 0.5744292736053467, 0.5697512030601501, 0.5585909485816956, 0.5583129525184631, 0.5580792427062988, 0.5486306548118591, 0.5418003797531128, 0.5374248027801514, 0.5313123464584351, 0.5255019664764404, 0.5239080786705017, 0.5222450494766235, 0.5183383226394653, 0.5122790336608887, 0.4967910349369049, 0.49450448155403137, 0.48508837819099426, 0.4846838712692261, 0.48313599824905396, 0.4781731963157654, 0.47713595628738403, 0.4755036532878876, 0.47283613681793213, 0.46673840284347534, 0.4650897681713104, 0.4611648917198181, 0.46098166704177856, 0.4564881920814514, 0.45621275901794434, 0.4511559307575226, 0.4504604637622833, 0.44923946261405945, 0.44764918088912964, 0.44366776943206787, 0.44305676221847534, 0.43911999464035034, 0.430